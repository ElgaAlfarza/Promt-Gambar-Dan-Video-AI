# ===================================================
# KONFIGURASI GEMINI AI (SALIN FILE INI MENJADI .env)
# Dapatkan API Key gratis di: https://aistudio.google.com/app/apikey
# ===================================================

# Kunci API untuk CLI / Backend (gemini.mjs)
GEMINI_API_KEY=your_gemini_api_key_here

# Kunci API untuk Frontend Vite / Web UI
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Model default (gemini-3.5-flash / gemini-3.1-flash-lite / gemini-3.7-flash)
VITE_GEMINI_MODEL=gemini-3.5-flash
